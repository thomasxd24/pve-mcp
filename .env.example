# Bearer token JARVIS sends (openssl rand -hex 32). Put the same value in the JARVIS integration's Authorization header.
MCP_TOKEN=
# Proxmox API: https://<node-ip>:8006 and an API token (see README).
PVE_URL=https://192.168.1.10:8006
PVE_TOKEN_ID=jarvis@pve!mcp
PVE_TOKEN_SECRET=
# Self-signed certificate on the LAN: 1 skips verification. Better: PVE_CA with /etc/pve/pve-root-ca.pem (\n for newlines).
PVE_INSECURE=1
# PVE_CA=
# SSH to the nodes (commands on nodes and in LXC containers). Addresses come from the cluster; override per node:
# SSH_HOSTS=pve1=192.168.1.10,pve2=192.168.1.11
# SSH_USER=root
# Lists the tools that delete, roll back, hard-stop or call any API write. Leave off.
# PVE_ALLOW_DESTRUCTIVE=1
