{
  "name": "pve-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for JARVIS to manage a Proxmox VE cluster, including commands inside VMs and LXC containers",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.9.0"
  }
}
